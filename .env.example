SCHWAB_CLIENT_ID=your_client_id_here
SCHWAB_CLIENT_SECRET=your_client_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=.token.json

# ── Shared NAS store (mintworker / studio split) ──────────────────────────────
# mintworker writes raw fetched data here (Synology RawSourceLibrary share)
NAS_RAW_ROOT=/Volumes/RawSourceLibrary
# studio writes processed outputs here (Synology Documents share)
NAS_DOCS_ROOT=/Volumes/Documents
