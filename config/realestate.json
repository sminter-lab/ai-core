{
  "_comment": "Single config for jobs/collect_realestate.py (MintWorker) and jobs/analyze_realestate.py (Studio). Craigslist feeds removed 2026-07-15: CL discontinued RSS (403s). Zillow RapidAPI is the sole source.",
  "project": "realestate",
  "collector": {
    "max_api_calls": 50,
    "max_items_per_feed": 10,
    "timeout_sec": 20,
    "failure_backoff_threshold": 3,
    "zillow": {
      "host": "zillow-com1.p.rapidapi.com",
      "locations": [
        "Atlanta, GA",
        "Birmingham, AL",
        "Huntsville, AL",
        "Nashville, TN",
        "Charlotte, NC",
        "Tampa, FL",
        "Jacksonville, FL",
        "Savannah, GA",
        "Chattanooga, TN"
      ],
      "params": {
        "home_type": "Houses,Multi-family",
        "minBeds": 2,
        "maxBeds": 4,
        "minPrice": 80000,
        "maxPrice": 600000,
        "sort": "Newest"
      }
    },
    "craigslist_residential": [],
    "craigslist_commercial": []
  },
  "analyzer": {
    "leads_per_day": 3,
    "min_surface_score": 7,
    "ollama_url": "http://127.0.0.1:11434",
    "ollama_model": "llama3.1:8b",
    "timeout_sec": 120
  }
}